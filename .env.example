# Configuration de connexion au cluster OpenSearch SOC.
# Copier ce fichier en .env et renseigner les valeurs, OU exporter ces
# variables dans le shell avant de lancer le client.

# Hôte du cluster OpenSearch SIEM
SOC_OS_HOST=localhost

# Port du cluster SIEM (distinct de l'indexer Wazuh sur 9200)
SOC_OS_PORT=9201

# Compte lecture seule dédié
SOC_OS_USER=soc_reader

# Mot de passe du compte (OBLIGATOIRE — pas de valeur par défaut)
SOC_OS_PASSWORD=changeme
#Mdp a changer apres

# Vérifier le certificat TLS. false pour les certificats auto-signés du lab.
SOC_OS_VERIFY=false

# Chemin du bundle CA, uniquement si SOC_OS_VERIFY=true
# SOC_OS_CA_CERT=/etc/opensearch/certs/root-ca.pem